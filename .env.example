# Frontend (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# engine/cli scripts (Node, local only — service-role key bypasses RLS,
# never ship it to the frontend). Same project as above.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Edge Function secrets — set via: supabase secrets set KEY=value
# RAPIDAPI_KEY=your_rapidapi_key          (API-Football on RapidAPI)
# ANTHROPIC_API_KEY=your_anthropic_key
# TELEGRAM_BOT_TOKEN=your_bot_token       (from @BotFather)
# TELEGRAM_CHAT_ID=your_channel_or_chat_id
